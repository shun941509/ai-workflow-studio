# Public web-service settings. Never place a service-role key or model credential here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Existing legacy anon keys remain supported through NEXT_PUBLIC_SUPABASE_ANON_KEY.
# Set the exact public origin when deploying behind a reverse proxy, for example https://studio.example.org.
STUDIO_PUBLIC_ORIGIN=
