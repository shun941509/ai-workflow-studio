{
  "schemaVersion": "1.0.0",
  "id": "official_EP_015",
  "revision": 1,
  "name": "요구사항 검증 설계",
  "entryNodeId": "request",
  "inputs": {
    "type": "object",
    "properties": {
      "goal": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "requirements": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "priority": {
              "enum": [
                "must",
                "should"
              ]
            }
          },
          "required": [
            "id",
            "text",
            "priority"
          ],
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 12
      },
      "availableEvidence": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "id",
            "description"
