                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "minItems": 0,
                "maxItems": 10
              },
              "externalActions": {
                "const": "none"
              },
              "answer": {
                "type": "string",
                "maxLength": 10000
              },
              "claims": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "citations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "citationId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "quote": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 3000
                          }
                        },
                        "required": [
                          "citationId",
                          "quote"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1,
                      "maxItems": 8
                    }
                  },
                  "required": [
                    "id",
