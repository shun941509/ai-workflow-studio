      "config": {
        "modelProfile": "comparison-model",
        "strategy": "task",
        "toolAllowlist": [],
        "maxSteps": 1,
        "resultSchema": {
          "type": "object",
          "properties": {
            "matrix": {
              "type": "array",
              "minItems": 2,
              "maxItems": 50,
