  "transport": "streamable-http",
  "auth": "host-oauth-2.1",
  "state": "implemented",
  "blockers": [],
  "readTools": [
    "getAccessibleAtlassianResources",
    "getJiraIssue",
    "searchJiraIssuesUsingJql",
