{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Top-left pixel rectangles refer to the original image. Structural validation cannot prove OCR accuracy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "imagePath",
    "language",
    "fields"
  ],
  "properties": {
    "fictional": {
      "type": "boolean"
    },
    "imagePath": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]{2,35}$"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "required",
          "rect"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "string",
              "integer",
              "date"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "rect": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "items": false
          }
        }
      }
    }
  }
}
