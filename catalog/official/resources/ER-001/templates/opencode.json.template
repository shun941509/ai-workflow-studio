{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "studio_github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "enabled": false
    }
  },
  "permission": {
    "studio_github_*": "deny",
    "studio_github_get_file_contents": "ask",
    "studio_github_issue_read": "ask",
    "studio_github_search_issues": "ask"
  }
}
