{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Canonical Studio v1 contract; generated TypeScript must not be edited independently.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "type": {
      "const": "knowledge"
    },
    "typeVersion": {
      "const": 1
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "inputBindings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "../binding.schema.json"
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "build",
            "update",
            "open",
            "delete"
          ]
        },
        "profile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "indexSettings": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "keyword",
                "vector",
                "hybrid",
                "graph"
              ]
            },
            "chunkSize": {
              "type": "integer",
              "minimum": 100,
              "maximum": 20000
            },
            "chunkOverlap": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "embeddingProfile": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            "graphExtractionProfile": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            "graphSummaryProfile": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            "entityTypes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0
            },
            "relationTypes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0
            }
          },
          "required": [
            "kind",
            "chunkSize",
            "chunkOverlap"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "operation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "build",
                  "update"
                ]
              }
            },
            "type": "object"
          },
          "then": {
            "required": [
              "profile",
              "indexSettings"
            ],
            "type": "object",
            "properties": {
              "profile": {},
              "indexSettings": {}
            }
          }
        }
      ]
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "../attachment.schema.json"
      },
      "minItems": 0
    },
    "execution": {
      "$ref": "../execution.schema.json"
    }
  },
  "required": [
    "id",
    "type",
    "typeVersion",
    "label",
    "inputBindings",
    "config",
    "attachments",
    "execution"
  ],
  "additionalProperties": false,
  "title": "KnowledgeNode"
}
