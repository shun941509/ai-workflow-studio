{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Canonical Studio v1 contract; generated TypeScript must not be edited independently.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "type": {
      "const": "loop"
    },
    "typeVersion": {
      "const": 1
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "inputBindings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "../binding.schema.json"
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "foreach",
            "until"
          ]
        },
        "bodyFlowRef": {
          "$ref": "../flow-ref.schema.json"
        },
        "maxIterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "untilExpression": {
          "$ref": "../expression.schema.json"
        }
      },
      "required": [
        "mode",
        "bodyFlowRef",
        "maxIterations"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "until"
              }
            },
            "type": "object"
          },
          "then": {
            "required": [
              "untilExpression"
            ],
            "type": "object",
            "properties": {
              "untilExpression": {}
            }
          }
        }
      ]
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "../attachment.schema.json"
      },
      "minItems": 0
    },
    "execution": {
      "$ref": "../execution.schema.json"
    }
  },
  "required": [
    "id",
    "type",
    "typeVersion",
    "label",
    "inputBindings",
    "config",
    "attachments",
    "execution"
  ],
  "additionalProperties": false,
  "title": "LoopNode"
}
