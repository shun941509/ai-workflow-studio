{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Canonical Studio v1 contract; generated TypeScript must not be edited independently.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "type": {
      "const": "agent"
    },
    "typeVersion": {
      "const": 1
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "inputBindings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "../binding.schema.json"
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "modelProfile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "instructions": {
          "type": "string"
        },
        "toolAllowlist": {
          "type": "array",
          "items": {
            "$ref": "../tool-ref.schema.json"
          },
          "minItems": 0
        },
        "maxSteps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "resultSchema": {
          "$ref": "../user-schema.schema.json"
        },
        "strategy": {
          "type": "string",
          "enum": [
            "task",
            "agentic_rag"
          ]
        },
        "retrievalPolicy": {
          "type": "object",
          "properties": {
            "maxRounds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "maxQueriesPerRound": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "maxRetrievedChunks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "maxContextTokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200000
            },
            "onInsufficient": {
              "type": "string",
              "enum": [
                "abstain",
                "ask"
              ]
            },
            "clarificationFlowRef": {
              "$ref": "../flow-ref.schema.json"
            }
          },
          "required": [
            "maxRounds",
            "maxQueriesPerRound",
            "maxRetrievedChunks",
            "maxContextTokens",
            "onInsufficient"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "modelProfile",
        "instructions",
        "toolAllowlist",
        "maxSteps",
        "resultSchema",
        "strategy"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "agentic_rag"
              }
            },
            "type": "object"
          },
          "then": {
            "required": [
              "retrievalPolicy"
            ],
            "type": "object",
            "properties": {
              "retrievalPolicy": {}
            }
          }
        }
      ]
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "../attachment.schema.json"
      },
      "minItems": 0
    },
    "execution": {
      "$ref": "../execution.schema.json"
    }
  },
  "required": [
    "id",
    "type",
    "typeVersion",
    "label",
    "inputBindings",
    "config",
    "attachments",
    "execution"
  ],
  "additionalProperties": false,
  "title": "AgentNode"
}
