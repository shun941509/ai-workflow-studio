{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Canonical Studio v1 contract; generated TypeScript must not be edited independently.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "type": {
      "const": "agent_team"
    },
    "typeVersion": {
      "const": 1
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "inputBindings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "../binding.schema.json"
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "role": {
                "type": "string"
              },
              "flowRef": {
                "$ref": "../flow-ref.schema.json"
              }
            },
            "required": [
              "id",
              "role",
              "flowRef"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "sequential",
            "parallel"
          ]
        },
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "integrationFlowRef": {
          "$ref": "../flow-ref.schema.json"
        }
      },
      "required": [
        "members",
        "mode",
        "maxConcurrency"
      ],
      "additionalProperties": false
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "../attachment.schema.json"
      },
      "minItems": 0
    },
    "execution": {
      "$ref": "../execution.schema.json"
    }
  },
  "required": [
    "id",
    "type",
    "typeVersion",
    "label",
    "inputBindings",
    "config",
    "attachments",
    "execution"
  ],
  "additionalProperties": false,
  "title": "AgentTeamNode"
}
