{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourceDescriptor",
  "$comment": "A ResourceRef hashes the original resource.json bytes; this descriptor pins every payload and dependency.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "revision", "kind", "name", "entrypoint", "license", "dependencies", "requiredConnections", "files"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["instruction", "document", "skill", "mcp"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "entrypoint": { "type": "string", "minLength": 1 },
    "license": { "type": "object", "additionalProperties": false, "required": ["id", "path"], "properties": { "id": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 } } },
    "dependencies": { "type": "object", "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" }, "additionalProperties": { "$ref": "resource-ref.schema.json" } },
    "requiredConnections": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" }, "uniqueItems": true },
    "files": { "type": "array", "minItems": 1, "maxItems": 1000, "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    } }
  }
}
