{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:studio:verification-record:1.0.0",
  "title": "VerificationRecord",
  "$comment": "Only an independently trusted verifier may attest an actual run. A JSON success flag or unit-test provider is insufficient.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "exampleId", "artifactSha256", "definitionSha256", "mode", "mocked", "status", "host", "hostVersion", "runnerVersion", "startedAt", "finishedAt", "capabilities", "acceptanceCriteria", "steps", "dependencies", "evidence", "signature"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "id": { "type": "string", "minLength": 1 }, "exampleId": { "type": "string", "pattern": "^E[PR]-[0-9]{3}$" },
    "artifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "definitionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mode": { "const": "real" }, "mocked": { "const": false }, "status": { "const": "passed" },
    "host": { "enum": ["codex", "claude-code", "opencode"] }, "hostVersion": { "type": "string", "minLength": 1 }, "runnerVersion": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "format": "date-time" }, "finishedAt": { "type": "string", "format": "date-time" },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "acceptanceCriteria": { "type": "string", "minLength": 1 },
    "steps": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["kind", "passed", "evidencePath"], "properties": { "kind": { "enum": ["host-entry", "runner-start", "result-received", "resource-use", "acceptance-check"] }, "passed": { "const": true }, "evidencePath": { "type": "string", "minLength": 1 } } } },
    "dependencies": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "mode", "version", "evidencePath"], "properties": { "id": { "type": "string", "minLength": 1 }, "mode": { "const": "actual" }, "version": { "type": "string", "minLength": 1 }, "evidencePath": { "type": "string", "minLength": 1 } } } },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } },
    "signature": { "type": "object", "additionalProperties": false, "required": ["algorithm", "keyId", "value"], "properties": { "algorithm": { "const": "Ed25519" }, "keyId": { "type": "string", "minLength": 1 }, "value": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" } } }
  }
}
