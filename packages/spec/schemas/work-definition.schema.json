{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkDefinition",
  "$comment": "One selected Card -> Role -> Task business definition. Inputs, outputs, completion criteria, policy, models and pinned resource bytes remain canonical on Workflow. This contract grants no permission and is not an execution context manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "revision", "card", "role", "task", "harness"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "card": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "purpose"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "role": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "responsibility"],
      "description": "The selected role belongs to the selected card. Its responsibility is business context, not a permission grant or professional credential.",
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "responsibility": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "task": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "goal", "criterionIds", "assets", "skills"],
      "description": "Exactly one selected task belongs to the selected role. Every completion criterion must be referenced; subsets cannot redefine business success.",
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "goal": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "criterionIds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" } },
        "assets": {
          "type": "array", "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["alias", "kind", "usage", "purpose", "required"],
            "properties": {
              "alias": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$", "description": "Exact alias in workflow.resources; never an account resource ID, copied bytes or an external URL." },
              "kind": { "enum": ["instruction", "document"] },
              "usage": { "enum": ["instructions", "reference", "template"] },
              "purpose": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "required": { "type": "boolean" }
            }
          }
        },
        "skills": {
          "type": "array", "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["alias", "kind", "usage", "purpose", "required"],
            "properties": {
              "alias": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
              "kind": { "const": "skill" },
              "usage": { "const": "instructions", "description": "Instruction/data bundle only; no tool allowlist, executable entrypoint, approval or permission follows from this link." },
              "purpose": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "required": { "type": "boolean" }
            }
          }
        }
      }
    },
    "harness": {
      "type": "object", "additionalProperties": false, "required": ["context", "perform", "accept", "deliver", "selectedContext"],
      "description": "Roles of actual root-flow nodes. These mappings do not introduce edges or duplicate execution policy. selectedContext is design-time selection, not a claim that runtime content was consumed.",
      "properties": {
        "workingContext": {
          "type": "object", "additionalProperties": false, "required": ["version", "maxBytes", "bindings"],
          "description": "Explicit bounded context preset. The Runner verifies actual prepared model requests; this declaration never proves a provider call or grants permission.",
          "properties": {
            "version": { "const": 1 },
            "maxBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576, "description": "Maximum UTF-8 bytes of the final canonical ModelRequest, including model, instructions, content and response format, before any count or generation disclosure." },
            "bindings": {
              "type": "array", "minItems": 1, "maxItems": 16,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["nodeId", "contextNodeId"],
                "properties": {
                  "nodeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
                  "contextNodeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" }
                }
              }
            }
          }
        },
        "context": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" } },
        "perform": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" } },
        "accept": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" } },
        "deliver": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" } },
        "selectedContext": { "type": "array", "maxItems": 80, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" }, "description": "Selected task asset/Skill aliases only. All required links must be selected; unselected optional links remain explicitly excluded." }
      }
    }
  }
}
