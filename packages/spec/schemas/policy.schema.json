{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Canonical Studio v1 contract; generated TypeScript must not be edited independently.",
  "type": "object",
  "properties": {
    "approvalMode": {
      "const": "per_effect"
    },
    "networkMode": {
      "const": "broker_only"
    },
    "filesystemMode": {
      "const": "workspace_only"
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxConcurrentNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "maxNodeInstances": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maxModelCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maxTotalTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "maxActiveMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "maxChildDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      },
      "required": [
        "maxConcurrentNodes",
        "maxNodeInstances",
        "maxModelCalls",
        "maxTotalTokens",
        "maxActiveMs",
        "maxChildDepth"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "approvalMode",
    "networkMode",
    "filesystemMode",
    "limits"
  ],
  "additionalProperties": false,
  "title": "WorkflowPolicy"
}
