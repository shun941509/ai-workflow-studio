;; Internal WASIp1 probe. Results are binary errno/count words followed by the actual input bytes.
;; No user path, environment secret, external URL or executable is embedded in this module.
(module
  (import "wasi_snapshot_preview1" "path_open" (func $open (param i32 i32 i32 i32 i32 i64 i64 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_read" (func $read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_write" (func $write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_close" (func $close (param i32) (result i32)))
  (import "wasi_snapshot_preview1" "environ_sizes_get" (func $env (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_unlink_file" (func $unlink (param i32 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 3000) "allowed.txt")
  (data (i32.const 3100) "../outside/private.txt")
  (data (i32.const 3200) "/outside/private.txt")
  (data (i32.const 3300) "../aap-canary/canary.txt")
  (data (i32.const 3500) "sandbox output")
  (func $record (param $index i32) (param $value i32)
    (i32.store (i32.mul (local.get $index) (i32.const 4)) (local.get $value)))
  (func (export "_start")
    ;; Only descriptor 3 (/input) and 4 (/output) are preopened. Opened file descriptors are private.
    (call $record (i32.const 0) (call $open (i32.const 3) (i32.const 0) (i32.const 3000) (i32.const 11) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0) (i32.const 400)))
    (i32.store (i32.const 420) (i32.const 2048))
    (i32.store (i32.const 424) (i32.const 13))
    (call $record (i32.const 1) (call $read (i32.load (i32.const 400)) (i32.const 420) (i32.const 1) (i32.const 440)))
    (call $record (i32.const 2) (i32.load (i32.const 440)))
    (drop (call $close (i32.load (i32.const 400))))
    ;; Requesting write rights must also pass the OS read-only input ACL, not just WASI names.
    (call $record (i32.const 3) (call $open (i32.const 3) (i32.const 0) (i32.const 3000) (i32.const 11) (i32.const 8) (i64.const 64) (i64.const 0) (i32.const 0) (i32.const 400)))
    (call $record (i32.const 4) (call $open (i32.const 4) (i32.const 0) (i32.const 3000) (i32.const 11) (i32.const 9) (i64.const 64) (i64.const 0) (i32.const 0) (i32.const 400)))
    (i32.store (i32.const 420) (i32.const 3500))
    (i32.store (i32.const 424) (i32.const 14))
    (call $record (i32.const 5) (call $write (i32.load (i32.const 400)) (i32.const 420) (i32.const 1) (i32.const 440)))
    (call $record (i32.const 6) (i32.load (i32.const 440)))
    (drop (call $close (i32.load (i32.const 400))))
    (call $record (i32.const 7) (call $open (i32.const 3) (i32.const 0) (i32.const 3100) (i32.const 22) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0) (i32.const 400)))
    (call $record (i32.const 8) (call $open (i32.const 3) (i32.const 0) (i32.const 3200) (i32.const 20) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0) (i32.const 400)))
    (call $record (i32.const 9) (call $open (i32.const 3) (i32.const 0) (i32.const 3300) (i32.const 22) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0) (i32.const 400)))
    (call $record (i32.const 10) (call $env (i32.const 460) (i32.const 464)))
    (call $record (i32.const 11) (i32.load (i32.const 460)))
    (call $record (i32.const 12) (i32.load (i32.const 464)))
    (call $record (i32.const 13) (call $unlink (i32.const 3) (i32.const 3000) (i32.const 11)))
    (call $record (i32.const 14) (call $open (i32.const 4) (i32.const 0) (i32.const 3100) (i32.const 22) (i32.const 9) (i64.const 64) (i64.const 0) (i32.const 0) (i32.const 400)))
    (i32.store (i32.const 420) (i32.const 0))
    (i32.store (i32.const 424) (i32.const 60))
    (i32.store (i32.const 428) (i32.const 2048))
    (i32.store (i32.const 432) (i32.const 13))
    ;; A stream may consume only the first iovec. Write the two small records separately.
    (drop (call $write (i32.const 1) (i32.const 420) (i32.const 1) (i32.const 480)))
    (drop (call $write (i32.const 1) (i32.const 428) (i32.const 1) (i32.const 480)))
  )
)
